# CloudKey 配置文件示例
# 复制为 config.yaml 并根据实际环境修改

# 应用设置
app:
  debug: false

# 服务器配置
server:
  host: "0.0.0.0"
  port: 8080

# 数据库配置（MySQL 8.0+）
database:
  type: mysql
  host: 127.0.0.1
  port: 3306
  user: cloudkey
  password: "your_db_password"
  dbname: cloudkey
  sslmode: disabled

# Redis 配置（消费缓存、限流、TOTP 暂存、Top Keys 排名等）
redis:
  host: 127.0.0.1
  port: 6379
  password: ""
  db: 0

# 认证配置
auth:
  # JWT 签名密钥，生产环境请使用随机强密钥
  secret: "change-me-to-a-random-secret"
  # JWT 过期时间（小时）
  expiration: 24
  # 超级管理员初始账号（首次启动时自动创建）
  super_admin_username: admin
  super_admin_password: "your_admin_password"

# 日志配置
log:
  level: info
  format: json
  output: stdout
  file:
    path: logs/cloudkey.log
    max_size: 100
    max_backups: 5
    max_age: 30
    compress: true

# 安全配置
security:
  encryption:
    enabled: false
    algorithm: aes-256-gcm
    key: ""

# RabbitMQ 配置（消费扣减和额度调整事件异步落库）
rabbitmq:
  host: 127.0.0.1
  port: 5672
  username: guest
  password: guest
