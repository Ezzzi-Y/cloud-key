server:
  host: "0.0.0.0"
  port: 8080

database:
  type: "mysql"
  host: "mysql"
  port: 3306
  user: "cloudkey"
  password: "cloudkey123"
  dbname: "cloudkey"
  sslmode: "disable"

log:
  level: "info"
  format: "json"
  output: "stdout"
  file:
    path: "logs/cloudkey.log"
    max_size: 100
    max_backups: 10
    max_age: 30
    compress: true

auth:
  secret: "change-me-to-a-random-string"
  expiration: 24
  super_admin_username: "admin"       # 超级管理员用户名（环境变量 SUPER_ADMIN_USERNAME 优先）
  super_admin_password: ""            # 超级管理员密码（环境变量 SUPER_ADMIN_PASSWORD 优先，必填其一）

app:
  debug: false

security:
  encryption:
    enabled: false
    algorithm: ""
    key: ""
