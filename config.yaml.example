server:
  host: "0.0.0.0"
  port: 8080

database:
  type: "mysql"
  host: "mysql"
  port: 3306
  user: "cloudkey"
  password: "cloudkey123"
  dbname: "cloudkey"
  sslmode: "disable"

log:
  level: "info"
  format: "json"
  output: "stdout"
  file:
    path: "logs/cloudkey.log"
    max_size: 100
    max_backups: 10
    max_age: 30
    compress: true

auth:
  secret: "your-jwt-secret-change-me"
  expiration: 24
  admin_username: "admin"       # 初始管理员用户名（环境变量 ADMIN_USERNAME 优先）
  admin_password: ""            # 初始管理员密码（环境变量 ADMIN_PASSWORD 优先，必填其一）

app:
  debug: false

security:
  encryption:
    enabled: false
    algorithm: ""
    key: ""
